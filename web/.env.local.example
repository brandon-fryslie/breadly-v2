# Copy to .env.local for local development.
# Matches docker-compose.yml at the repo root.

DATABASE_URL=postgres://breadly_app:breadly_local@localhost:5432/breadly
BREADLY_ENV=dev

# Single switch for /dev-tools and any other dev-only surfaces. Default
# closed — set "true" only locally and on the dev Cloud Run service.
BREADLY_DEV_MODE=true

# Clerk — get keys from your Clerk dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Object storage — local dev points at the dev GCP bucket. Skip if you
# don't need photo upload locally; the post-a-loaf form has a "paste a URL"
# escape hatch that works without GCS access.
#
# To exercise the real signed-URL flow locally:
#   1. `gcloud auth application-default login`
#      (the @google-cloud/storage SDK uses ADC; on Cloud Run it resolves to
#       the runtime SA via the metadata server — same code path.)
#   2. Make sure your account has objectAdmin on the dev photos bucket.
PHOTOS_BUCKET=breadly-dev-photos
UPLOADS_BUCKET=breadly-dev-uploads

# Email — Resend; optional locally
RESEND_API_KEY=re_REPLACE_ME
