# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code runtime artifacts (lock files etc.). Settings/hooks
# under .claude/ are still allowlistable explicitly if we decide
# to track them.
.claude/

# dependencies
web/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
web/.next/
web/out/

# production
web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# terraform
infra/**/.terraform/
infra/**/.terraform.lock.hcl
infra/**/terraform.tfstate
infra/**/terraform.tfstate.backup
infra/**/terraform.tfvars
infra/**/*.auto.tfvars
infra/**/.terraform.tfstate.lock.info
infra/**/plan*.out
